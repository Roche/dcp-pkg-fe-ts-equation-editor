{
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "module": "esnext",
    "target": "es6",
    "lib": [
      "es2017",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}